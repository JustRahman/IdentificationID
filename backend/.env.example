# App
DEBUG=false
SECRET_KEY=change-me-in-production

# Database
# NOTE: Use postgresql+asyncpg:// scheme (not postgresql://)
# Example: postgresql+asyncpg://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/identification_id

# JWT
JWT_SECRET=change-me
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage (S3 / Supabase Storage)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
SENDGRID_API_KEY=
FROM_EMAIL=noreply@identificationid.com

# CORS
FRONTEND_URL=http://localhost:3000
